# Bay-Max Environment Variables
# Copy this file to .env and adjust values for your environment.

# Required data directories (must exist before running)
BAYMAX_DATA_DIR=/scratch/$USER/bay-max/data
BAYMAX_CACHE_DIR=/scratch/$USER/bay-max/cache
BAYMAX_MODEL_DIR=/scratch/$USER/bay-max/models
BAYMAX_DB_URL=sqlite:///./baymax.db

# Device selection: "cpu", "cuda", or "cuda_if_available_else_cpu"
# BAYMAX_DEVICE=cuda_if_available_else_cpu

# Face recognition
# BAYMAX_FACE_BACKEND=facenet_pytorch
# BAYMAX_FACE_MATCH_THRESHOLD=0.75

# Pose estimation
# BAYMAX_POSE_BACKEND=mediapipe
# BAYMAX_POSE_MIN_CONFIDENCE=0.5

# Annotation and debug artifacts
# BAYMAX_ENABLE_ANNOTATIONS=true
# BAYMAX_ARTIFACT_DIR=./artifacts

# Logging
# BAYMAX_LOG_LEVEL=INFO

# Vector store and text embedding (Iteration 004)
# BAYMAX_VECTOR_BACKEND=lancedb
# BAYMAX_TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2
# BAYMAX_TEXT_EMBEDDING_DIM=384

# Memory retrieval
# BAYMAX_MEMORY_TOP_K=5
# BAYMAX_MEMORY_SIMILARITY_THRESHOLD=0.4

# Session smoothing (frames)
# BAYMAX_SESSION_SMOOTHING_WINDOW=5

# Consolidation
# BAYMAX_ENABLE_MEMORY_CONSOLIDATION=true

# ---- Iteration 005: Local Dialogue Backend ----

# Select active dialogue backend: rule_based | ollama | transformers
# Default: rule_based (no model required)
BAYMAX_DIALOGUE_BACKEND=rule_based

# Enable rule-based fallback when the chosen backend fails
# BAYMAX_ENABLE_RULE_BASED_FALLBACK=true

# Enable structured debug fields in /v1/respond responses
# BAYMAX_ENABLE_DIALOGUE_DEBUG=false

# Safe-health mode: refuse to make diagnostic claims
# BAYMAX_ENABLE_SAFE_HEALTH_MODE=true

# Grounded prompt context window
# BAYMAX_DIALOGUE_MAX_HISTORY_TURNS=8
# BAYMAX_DIALOGUE_TOP_K_MEMORIES=5

# Generation parameters (for Ollama and Transformers backends)
# BAYMAX_DIALOGUE_TEMPERATURE=0.4
# BAYMAX_DIALOGUE_MAX_NEW_TOKENS=220

# --- Ollama backend (BAYMAX_DIALOGUE_BACKEND=ollama) ---
# Requires: ollama running locally.  See docs/LOCAL_TESTING.md
# BAYMAX_OLLAMA_BASE_URL=http://localhost:11434
# BAYMAX_OLLAMA_MODEL=qwen2.5:1.5b

# --- Transformers backend (BAYMAX_DIALOGUE_BACKEND=transformers) ---
# Requires: pip install -e ".[dialogue]"  (installs transformers + torch)
# Model is downloaded to BAYMAX_MODEL_DIR on first use.
# BAYMAX_HF_CHAT_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# BAYMAX_HF_DTYPE=auto

# ---- Iteration 006: Live Webcam Continuity ----

# Source type: "webcam" | "replay"
# BAYMAX_LIVE_SOURCE=webcam
# BAYMAX_LIVE_CAMERA_INDEX=0

# Frame rate and analysis cadence
# BAYMAX_PREVIEW_FPS=8
# BAYMAX_ANALYSIS_INTERVAL_SEC=2.0

# Presence detection
# BAYMAX_PRESENCE_MIN_CONSECUTIVE_FRAMES=2
# BAYMAX_ABSENCE_TIMEOUT_SEC=30
# BAYMAX_SESSION_RESUME_WINDOW_SEC=300

# Response cooldowns
# BAYMAX_PROACTIVE_MIN_INTERVAL_SEC=30
# BAYMAX_ANY_RESPONSE_MIN_INTERVAL_SEC=10
# BAYMAX_QUIET_COMPANIONSHIP_INTERVAL_SEC=300
# BAYMAX_EVENT_MIN_STABILITY_SEC=4

# Live overlay and artifacts
# BAYMAX_ENABLE_LIVE_OVERLAY=true
# BAYMAX_ENABLE_ARTIFACT_LOGGING=true
# BAYMAX_LIVE_ARTIFACT_DIR=./artifacts/live_run_006
# BAYMAX_LIVE_MAX_RUN_SEC=0
# BAYMAX_LIVE_VIDEO_REPLAY_PATH=
