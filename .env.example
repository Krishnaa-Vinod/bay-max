# Bay-Max Environment Variables
# Copy this file to .env and adjust values for your environment.

# Required data directories (must exist before running)
BAYMAX_DATA_DIR=/scratch/$USER/bay-max/data
BAYMAX_CACHE_DIR=/scratch/$USER/bay-max/cache
BAYMAX_MODEL_DIR=/scratch/$USER/bay-max/models
BAYMAX_DB_URL=sqlite:///./baymax.db

# Optional
# BAYMAX_LOG_LEVEL=INFO
